rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function userType() { return get(/databases/$`(database)/documents/users/`$(request.auth.uid)).data.type; }
    function isAdmin() { return userType() == 'admin'; }
    function isGuru() { return userType() == 'guru' || isAdmin(); }
    function isSiswa() { return userType() == 'siswa'; }

    match /teachers/{email} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /classes/{cid} {
      allow read: if isAuth();
      allow create: if isGuru() && (
        get(/databases/$`(database)/documents/classes).size() < 15
      );
      allow update, delete: if isGuru();
    }

    match /stages/{cid} {
      allow read: if isAuth();
      allow write: if isGuru();
    }

    match /activeStages/{cid} {
      allow read: if isAuth();
      allow write: if isGuru();
    }

    match /scores/{sid} {
      allow read: if isAuth();
      allow create, update: if isGuru() || (
        isSiswa() &&
        request.resource.data.evaluatorId == request.auth.uid
      );
      allow delete: if isGuru();
    }

    match /schedules/{sid} {
      allow read: if isAuth();
      allow write: if isGuru() || isSiswa();
    }

    match /bookings/{bid} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isGuru() || (
        resource.data.userId == request.auth.uid
      );
    }

    match /meetings/{mid} {
      allow read: if isAuth();
      allow create: if isGuru() || isSiswa();
      allow update: if isAuth();
      allow delete: if isGuru();
    }

    match /checklists/{cid} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /notifications/{nid} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isGuru();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
