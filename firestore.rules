rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config & Templates: read semua, write guru/admin
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /templates_shared/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Teachers: admin only untuk write
    match /teachers/{email} {
      allow read: if true;
      allow write: if true;
    }

    // Classes: siapa saja bisa baca (untuk dropdown), 
    // tulis dibatasi guru pemilik/admin
    match /classes/{cid} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Notifications: baca semua, tulis siapa saja
    match /notifications/{id} {
      allow read, write: if true;
    }

    // Evaluations, Deadlines, ActiveStages, Checklists, Meetings
    // baca/tulis kelas sendiri
    match /evaluations/{id} { allow read, write: if true; }
    match /deadlines/{id} { allow read, write: if true; }
    match /activeStages/{id} { allow read, write: if true; }
    match /checklists/{id} { allow read, write: if true; }
    match /meetings/{id} { allow read, write: if true; }
    match /activity_logs/{id} { allow read, write: if true; }

    // Koordinasi antar kelas: lintas kelas boleh
    match /coordination/{id} { allow read, write: if true; }

    // Bookings (lintas kelas)
    match /bookings/{id} { allow read, write: if true; }

    // Tasks
    match /tasks/{id} { allow read, write: if true; }

    // Aduan
    match /aduan/{id} { allow read, write: if true; }

    // WA Logs
    match /wa_logs/{id} { allow read, write: if true; }

    // Keuangan, Kas, Peminjaman
    match /keuangan/{id} { allow read, write: if true; }
    match /kas_kelas/{id} { allow read, write: if true; }
    match /peminjaman/{id} { allow read, write: if true; }

    // Master Schedule & Jadwal
    match /master_schedule/{id} { allow read, write: if true; }
    match /jadwal_divisi/{id} { allow read, write: if true; }
    match /kalender_konten/{id} { allow read, write: if true; }
    match /jadwal_latihan/{id} { allow read, write: if true; }

    // Template uploads
    match /template_uploads/{id} { allow read, write: if true; }

    // GDrive links
    match /gdrive_links/{id} { allow read, write: if true; }
  }
}
